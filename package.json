{
  "name": "open-practice",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env adapters/node/server.mjs",
    "start": "node adapters/node/server.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "npm test && node scripts/check-secrets.mjs",
    "deploy": "npx wrangler@latest deploy --config adapters/cloudflare/wrangler.jsonc",
    "build:assets": "python3 scripts/build-curriculum.py && python3 scripts/build-activities.py && node scripts/build-offline-assets.mjs && node scripts/build-inline-assets.mjs",
    "build:curriculum": "python3 scripts/build-curriculum.py && python3 scripts/build-activities.py",
    "deploy:fresh": "npx wrangler@latest deploy --config adapters/cloudflare/wrangler.fresh-install.jsonc",
    "build:activities": "python3 scripts/build-activities.py"
  }
}
