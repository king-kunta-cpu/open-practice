# Copy to .env for local Node only. Never commit the populated file.
AI_ENABLED=false
PORT=3001
# Set your external HTTPS origin behind a reverse proxy.
# PUBLIC_ORIGIN=https://school.example.org
AI_PROVIDER_ORDER=groq,cloudflare,pollinations
# Choose exact model IDs after checking availability and terms in your account.
GROQ_MODEL=
GROQ_API_KEY=
CLOUDFLARE_MODEL=
# Node only: Cloudflare Worker deployment uses its native AI binding instead.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=
POLLINATIONS_MODEL=
POLLINATIONS_KEY=
# Exact provider:model pairs. Empty means no models are approved.
APPROVED_MODELS=
